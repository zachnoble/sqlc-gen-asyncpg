{
  "version": "2",
  "sql": [
    {
      "engine": "postgresql",
      "schema": "schema.sql",
      "queries": [
        "query.sql"
      ],
      "codegen": [
        {
          "plugin": "py",
          "out": "gen",
          "options": {
            "emit_methods_with_db_argument": true,
            "emit_prepared_queries": true
          }
        }
      ]
    }
  ]
}

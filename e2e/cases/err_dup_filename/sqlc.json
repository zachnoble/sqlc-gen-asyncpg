{
  "version": "2",
  "sql": [
    {
      "engine": "postgresql",
      "schema": "schema.sql",
      "queries": [
        "query.sql"
      ],
      "codegen": [
        {
          "plugin": "py",
          "out": "gen",
          "options": {
            "output_db_file_name": "models.py"
          }
        }
      ]
    }
  ]
}
